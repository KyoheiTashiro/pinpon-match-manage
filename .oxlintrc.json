{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // react-perf プラグインは外している:
  // jsx-no-new-{function,object,array}-as-prop / jsx-no-jsx-as-prop は
  // 子コンポーネントが React.memo されている場合にのみ意味があるが、
  // このコードベースでは memo を使っていないため全て誤検知になる。
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "settings": {
    "react": {
      "version": "19"
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    // import 数の上限は 20 まで許可
    "import/max-dependencies": ["error", { "max": 20 }],
    // CSS の副作用 import (main.tsx の index.css) は意図的なので許可
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
    // max-lines-per-function: 閾値が恣意的で、JSX を返す React コンポーネントは本質的に
    // 1 関数が長くなる。分割の判断はレビューに委ねるため off。
    "eslint/max-lines-per-function": "off",
    // no-inline-comments: 本コードベースは意図・根拠を行末/行内コメントで明示する方針
    // （この設定ファイル自体もそう）。意図的なスタイルなので off。
    "eslint/no-inline-comments": "off",
    // prefer-readonly-parameter-types: 全ての object/array 引数に Readonly<> を強制する。
    // React props・zustand/immer の slice・ドメイン関数の引数すべてに波及して誤検知が大量に出る一方、
    // immer 下では draft をミューテートするのが正であり readonly 化は実態と矛盾する。費用対効果が低いため off。
    "typescript/prefer-readonly-parameter-types": "off",
    // no-confusing-void-expression: zustand の `(set) => set(...)` のようなアロー短縮形で
    // void を返すのは本コードベースの定型。実害がないアロー短縮形のみ許可し、その他の紛らわしい
    // void 式（引数渡し・戻り値利用）は引き続き検出する。
    "typescript/no-confusing-void-expression": ["error", { "ignoreArrowShorthand": true }],
    // strict-boolean-expressions: 検出の過半は Record/配列の index アクセスが
    // noUncheckedIndexedAccess 無効により `T`（undefined 無し）と推論され、既存の防御的
    // `if (!x) return` ガードが「常に truthy」と誤検知されるもの。残りも `{label && <jsx>}` 等の
    // React 慣用的な条件描画で、満たすには冗長な明示比較が必要。バグ検出価値が低いため off。
    // （根本対処として noUncheckedIndexedAccess 有効化は別途検討。新規 tsc エラー誘発のため本件では見送り。）
    "typescript/strict-boolean-expressions": "off"
  },
  "ignorePatterns": ["dist", "dev-dist", "node_modules", "**/*.config.{ts,js}"],
  "overrides": [
    {
      "files": ["**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}"],
      "plugins": ["vitest"],
      "rules": {
        "vitest/no-disabled-tests": "warn",
        "vitest/no-focused-tests": "error"
      }
    },
    {
      // no-array-index-key を off にするファイル群:
      // ゲームタブ・ゲーム一覧は「n ゲーム目」という位置そのものが同一性で、
      // 得点経過チャートのラリー列・SVG 線分は append-only の時系列。
      // いずれも並べ替え・途中挿入が起きないため index キーが正当。
      "files": [
        "src/features/tournament/matrix/components/MatchModal.tsx",
        "src/features/tournament/matrix/components/GameList.tsx",
        "src/features/tournament/scoreboard/components/ScoreboardHeader.tsx",
        "src/features/tournament/matrix/components/scoreboard/ScoreProgressChart.tsx"
      ],
      "rules": {
        "react/no-array-index-key": "off"
      }
    },
    {
      // prefer-tag-over-role を off にするファイル群:
      // - モーダルコンテナに role="dialog" を使っているが、<dialog> ネイティブ要素への移行は
      //   showModal() 制御が必要で挙動が変わるため行わない。
      // - Toggle の role="radio" ボタンも、ネイティブ <input type="radio"> 化は
      //   カスタムスタイルが壊れるため行わない。
      // - Select の role="listbox"/role="option" は、シェブロン回転などの
      //   カスタム UI が必要なため <select>/<option> への置き換えは行わない。
      "files": [
        "src/components/ui/Toggle.tsx",
        "src/components/ui/Select.tsx",
        "src/features/tournament/matrix/components/MatchModal.tsx",
        "src/features/tournament/scoreboard/components/ScoreboardScreen.tsx"
      ],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    }
  ]
}
